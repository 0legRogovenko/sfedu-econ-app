DATABASE_URL=postgresql+psycopg2://sfedu:sfedu@localhost:5433/sfedu_econ
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me-long-random-string
# На публичном serverless beta sqladmin выключается целиком. На VPS оставьте 1
# и открывайте админку только через SSH-туннель, как описано в DEPLOY.md.
ADMIN_ENABLED=1

# --- Продакшен (docker-compose.prod.yml) -----------------------------------
# Нужны только для prod-compose; для локальной разработки можно не задавать
# (dev-compose использует sfedu:sfedu и localhost).
DOMAIN=
DB_PASSWORD=

# AI-помощник. Без ключа помощник отвечает заглушкой с контактами деканата.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-4-5
ASSISTANT_DAILY_LIMIT=20
# Глобальный суточный потолок оплаченных вызовов по всем устройствам (защита
# бюджета ключа от обхода per-device лимита сменой device_id).
ASSISTANT_GLOBAL_DAILY_LIMIT=500
# Хранение логов помощника (вопрос/ответ + device_id): старше — авточистка.
ASSISTANT_LOG_RETENTION_DAYS=180

# Фоновые задачи. По умолчанию ВЫКЛЮЧЕНЫ: иначе стартовали бы в тестах и при
# alembic. В контейнере api включаются через docker-compose.yml.
ENABLE_SCHEDULER=0
NEWS_POLL_MINUTES=30
SCHEDULE_IMPORT_HOURS=24
STAFF_IMPORT_HOURS=24

# Уведомления о падении парсеров. Без них сбой виден только в логе.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
